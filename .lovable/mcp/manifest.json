{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "gmay-2-0",
      "version": "0.1.0",
      "title": "GMAY 2.0"
    },
    "tools": [
      {
        "name": "hertz_contact",
        "title": "Hertz temas hesabı (küre–düzlem)",
        "description": "Küre–düzlem elastik Hertz temasını hesaplar: maksimum temas basıncı, temas yarıçapı, temas alanı, ortalama basınç, indirgenmiş elastisite modülü ve yaklaşma miktarı.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "force_N": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Normal yük [N]"
            },
            "sphere_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Küre çapı [mm]"
            },
            "e1_GPa": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Küre elastisite modülü [GPa]"
            },
            "nu1": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.5,
              "description": "Küre Poisson oranı (0 ≤ ν < 0.5)"
            },
            "e2_GPa": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Düzlem elastisite modülü [GPa]"
            },
            "nu2": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.5,
              "description": "Düzlem Poisson oranı (0 ≤ ν < 0.5)"
            }
          },
          "required": [
            "force_N",
            "sphere_diameter_mm",
            "e1_GPa",
            "nu1",
            "e2_GPa",
            "nu2"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "wear_rate",
        "title": "Aşınma oranı hesabı",
        "description": "Aşınma hacminden veya kütle kaybı + yoğunluktan hacimsel aşınma oranı ve özgül aşınma oranı k_s = V / (F × s) hesaplar.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "wear_volume_mm3": {
              "description": "Aşınma hacmi [mm³]. Verilmezse mass_loss_mg ve density_g_cm3 gereklidir.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass_loss_mg": {
              "description": "Kütle kaybı [mg]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "density_g_cm3": {
              "description": "Malzeme yoğunluğu [g/cm³]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "force_N": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Normal yük [N]"
            },
            "sliding_distance_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Toplam kayma mesafesi [m]"
            }
          },
          "required": [
            "force_N",
            "sliding_distance_m"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "sliding_distance",
        "title": "Kayma mesafesi hesabı",
        "description": "Dönel (pin-on-disc) veya ileri-geri (reciprocating) hareket için toplam kayma mesafesi, çevrim sayısı ve kayma hızını hesaplar.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "rotary",
                "reciprocating"
              ],
              "description": "Hareket tipi"
            },
            "track_radius_mm": {
              "description": "Dönel mod: aşınma izi yarıçapı [mm]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rpm": {
              "description": "Dönel mod: dönme hızı [rpm]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stroke_mm": {
              "description": "İleri-geri mod: strok uzunluğu [mm]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frequency_Hz": {
              "description": "İleri-geri mod: çevrim frekansı [Hz]",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration_min": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Deney süresi [dakika]"
            }
          },
          "required": [
            "mode",
            "duration_min"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "engineering_prompt_builder",
        "title": "Engineering Prompt Builder",
        "description": "Mühendislik görevleri için yapılandırılmış Türkçe yapay zekâ promptu üretir (rol, görev, bağlam, kısıtlar, analiz gereksinimleri, çıktı biçimi, kalite kontrol).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "description": "Mühendislik alanı. Seçenekler: Makine Mühendisliği, Üretim, Malzeme Mühendisliği, Triboloji, CAD / CAE, Bakım ve Güvenilirlik, Kalite, Ar-Ge, Akademik Araştırma, Genel Mühendislik"
            },
            "task": {
              "type": "string",
              "description": "Görev. Seçenekler: Analiz et, Karşılaştır, Problem çöz, Açıkla, Teknik rapor hazırla, Deney planla, Literatür araştırması planla, Kod üret, Kontrol et / gözden geçir, FMEA oluştur, Kök neden analizi yap, Proje planla, Karar desteği sağla"
            },
            "output_format": {
              "type": "string",
              "description": "Çıktı biçimi. Seçenekler: Adım adım analiz, Teknik rapor, Tablo, Kontrol listesi, Mühendislik hesaplama planı, Araştırma planı, Deney planı, FMEA tablosu, Python kodu, Sunum taslağı, Yönetici özeti"
            },
            "context": {
              "type": "string",
              "minLength": 20,
              "description": "Problem / bağlam açıklaması (en az 20 karakter)"
            },
            "constraints": {
              "description": "Kısıtlar ve özel gereksinimler",
              "type": "string"
            },
            "detail": {
              "description": "Detay seviyesi. Varsayılan: Standart. Seçenekler: Kısa, Standart, Ayrıntılı",
              "type": "string",
              "enum": [
                "Kısa",
                "Standart",
                "Ayrıntılı"
              ]
            },
            "styles": {
              "description": "Yanıt yaklaşımları. Seçenekler: Varsayımları açıkça belirt, Belirsizlikleri belirt, Gerekirse alternatif çözümler sun, Hesaplamalarda birimleri göster, Avantaj / dezavantaj karşılaştırması yap, Sonuçta uygulanabilir öneriler ver, Kaynak gerektiren iddiaları işaretle, Güvenlik açısından kritik noktaları belirt",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "field",
            "task",
            "output_format",
            "context"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "latest_articles",
        "title": "Son yazılar",
        "description": "Gökçe Mehmet Ay'ın 'Mühendisliğin Yapay Zekâ Mentoru' Substack bülteninden yayımlanmış son yazıları listeler.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Kaç yazı döndürülsün (1-12)",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
